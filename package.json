{
  "name": "dsh-boss-assistant",
  "version": "1.0.0",
  "description": "老板超级助手 · 人财事三视图：把一整页「老板超级助手」收成 DSH 插件——侧边栏入口 + 中央整页，18 个视图，数据落本机",
  "type": "module",
  "main": "./dsh/index.mjs",
  "exports": {
    ".": "./dsh/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dsh",
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    },
    "host": {
      "imports": [
        "zod"
      ]
    }
  },
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "sideEffects": false,
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "workbench",
    "dashboard",
    "operations"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/leishenai/dsh-boss-assistant.git"
  },
  "homepage": "https://github.com/leishenai/dsh-boss-assistant",
  "bugs": {
    "url": "https://github.com/leishenai/dsh-boss-assistant/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/make-shell.mjs && node scripts/build-client.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:host": "node scripts/test-host.mjs",
    "check": "node --check lib/client.js && node --check dsh/index.mjs && node scripts/smoke.mjs && node scripts/test-host.mjs",
    "stage": "node scripts/stage.mjs",
    "pack": "npm run check && npm run stage && node scripts/pack.mjs"
  },
  "private": true
}
